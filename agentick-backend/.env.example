POSTGRES_DB=agentick
POSTGRES_USER=agentick
POSTGRES_PASSWORD=agentick_local_dev
DATABASE_URL=postgresql+psycopg://agentick:agentick_local_dev@db:5432/agentick

INTERNAL_ADMIN_TOKEN=change-me

# HS256 JWT signing secret for the /auth endpoints. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret

# "local" or "staging" serve /docs, /redoc, /openapi.json; anything else (e.g. "production") disables them.
ENVIRONMENT=local
